{
  "name": "netguard-security-desk",
  "productName": "NetGuard Security Desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "package": "electron-builder --win --x64",
    "package:exe": "npm run build && electron-builder --win --x64",
    "package:packager": "electron-packager . NetGuard-Security-Desk --platform=win32 --arch=x64 --out=dist/packaged --overwrite"
  },
  "build": {
    "appId": "com.netguard.app",
    "productName": "NetGuard Security Desk",
    "artifactName": "NetGuard-Security-Desk-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "NetGuard-Security-Desk-Setup-${version}.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "dist/**/*"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "bundled-deps",
        "to": "bundled-deps",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "dist/packaged"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
